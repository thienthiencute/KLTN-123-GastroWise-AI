# GastroWise AI Microservice Environment Configuration
# MONGODB CONNECTION (Least-Privilege User: gastrowise_ai_service)
# Role: gastrowiseAiMicroserviceRole (find on gastrowise.restaurants only)
# Replace <YOUR_AI_SERVICE_PASSWORD> with the secret password:
MONGODB_URI=mongodb+srv://gastrowise_ai_service:<YOUR_AI_SERVICE_PASSWORD>@cluster01.adts0oq.mongodb.net/gastrowise?appName=Cluster01
MONGODB_DB_NAME=gastrowise
MONGODB_COLLECTION_NAME=restaurants

# AI Service Server Configuration
HOST=127.0.0.1
PORT=5000
